  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": false,
    "types": [],
    "paths": {
      "@accordiondeck/react": ["./dist/index.d.ts"]
    }
  },
  "include": ["test"]
}
