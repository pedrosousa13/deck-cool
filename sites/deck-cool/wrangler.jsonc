{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The umbrella site, as Workers Static Assets: no Worker code, only site/.
  // Runbook: docs/deploy.md.
  "name": "deck-cool",
  // Not a secret: an account ID grants nothing without a token.
  "account_id": "c0bf36f52ec4652dabdacd6538b54983",
  "compatibility_date": "2026-10-01",
  // One address: deck.cool, and no workers.dev one.
  "workers_dev": false,
  "routes": [{ "pattern": "deck.cool", "custom_domain": true }],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    // The site declares no 404 page, and .assetsignore keeps the adapter's
    // fallback out of the upload, so a missing path answers a bare 404.
    "not_found_handling": "none"
  }
}
